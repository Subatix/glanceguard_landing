#
# Duplicate as `.env.local` for local Next.js (`gitignore`d). Configure the same secrets in Vercel.
#

# --- Site URLs (never hardcode URLs in Components for production) -------------
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_GLANCEGUARD_REPO_URL=https://github.com/Subatix/glanceguard
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional: direct DMG link when CDN/signed URLs exist (fallback: GitHub Releases).
NEXT_PUBLIC_DMG_DOWNLOAD_URL=

# --- Neon (Drizzle) -----------------------------------------------------------
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Stripe (test mode recommended first per DECISIONS D3) -------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# JWT signing · Ed25519 PKCS#8 PEM (do not reuse production keys casually)
ED25519_PRIVATE_KEY=
LICENSE_PUBKEY=

# --- Existing Phase 9 updater JSON blob ---------------------------------------
GLANCEGUARD_UPDATER_MANIFEST=
